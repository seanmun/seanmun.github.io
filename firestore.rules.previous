// PREVIOUS Firestore rules for seanmun.com — published 2025-10-30, replaced
// 2026-09-25 when analytics moved server-side. Kept for reference only.
// Do not publish: `allow read: if true` below made all visitor analytics
// downloadable by anyone holding the public web API key.

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow pageview tracking from client side
    match /pageviews/{pageviewId} {
      // Anyone can create tracking events (pageviews, project clicks, modal opens, link clicks)
      allow create: if
        request.resource.data.keys().hasAll(['cookieId', 'eventType']) &&
        request.resource.data.cookieId is string &&
        request.resource.data.eventType in ['pageview', 'project_click', 'modal_open', 'link_click'];

      // No updates or deletes from client side
      allow update, delete: if false;

      // Allow reading pageviews from any source (for dashboard access)
      allow read: if true;
    }

    // Allow tracking dashboard visitors for analytics exclusion
    match /admin_visitors/{visitorId} {
      allow read: if true;
      allow create, update: if
        request.resource.data.keys().hasAll(['visitorId']) &&
        request.resource.data.visitorId is string;
      allow delete: if false;
    }

    // Deny access to all other collections by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
